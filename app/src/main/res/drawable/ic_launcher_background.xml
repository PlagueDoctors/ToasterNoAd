<?xml version="1.0" encoding="utf-8"?>
<!--
    NoAd 应用图标 — 自适应图标背景层

    ## 设计决策：为什么是原创图形而非引用图标库

    图标库（Material Symbols / Lucide / Phosphor 等）虽然都是宽松许可
    （Apache-2.0 / ISC / MIT），但都附带「保留版权与许可声明」的义务。
    对于一个启动器图标而言，把第三方许可声明塞进「关于」页
    属于不必要的合规负担。

    因此本图标为**完全原创**的矢量绘制：
    - 图形语言：翡翠渐变底 + 中心白色方框与斜杠（见 foreground 层）
    - 未复用任何第三方图标库的路径数据
    - 无任何品牌标识（不使用 Android 机器人、盾牌商标等）

    ⚠️ 注意：项目内使用的 Material Icons（Compose 的 Icons.Rounded.*）
    本身是 Apache-2.0，属于正常依赖使用，与「图标库图案是否可作为
    应用图标」是两个独立问题。此处仅说明应用图标本身为原创。

    ## 视觉概念

    背景层承担「品牌色」职责：从深青到翡翠的对角渐变，
    与 `ui/theme/Color.kt` 的 EmeraldPrimary(#00D9A3) /
    CyanSecondary(#4DD0E1) 色板同源。

    ## 自适应图标安全区

    108x108 画布中，只有中心 72x72 是保证可见的安全区
    （外围 18 会被各厂商裁切成圆形 / 方形 / 水滴形）。
    本背景层铺满 108x108，由系统按各厂商形状裁切 —— 这是自适应图标的标准做法。

    ## 与位图的一致性

    几何与配色参数同时存在于 `tools/gen_icon_pngs.py`（生成 mipmap 位图）。
    修改本文件后必须同步该脚本的 BG_A / BG_B / BG_C / GLOW / COOL 常量，
    否则矢量图标与位图图标会出现色差。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底色：深空青。避免渐变边缘出现透明像素被裁切后发灰 -->
    <path
        android:fillColor="@color/ic_launcher_background_dark"
        android:pathData="M0,0h108v108h-108z" />

    <!-- 主渐变：左上深青 → 右下翡翠 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#0B3A2E" android:offset="0.0" />
                <item android:color="#0E5C46" android:offset="0.45" />
                <item android:color="#0A7D5E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
        右上角柔光：制造光源感，让纯色背景不平。
        径向渐变从翡翠色渐隐到全透明。

        透明端写 #00000000（alpha=0 的黑）而非 #0000D9A3，
        两者渲染结果相同（alpha=0 时 RGB 不参与混合），
        但前者是所有渲染器都保证正确处理的写法。
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="82"
                android:centerY="26"
                android:gradientRadius="72">
                <item android:color="#4D00D9A3" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
        左下角冷色补充：拉大明暗层次。
        对应应用次色 CyanSecondary，但只用极低透明度，
        避免背景过于花哨而让前景图形失去可读性。
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="18"
                android:centerY="94"
                android:gradientRadius="60">
                <item android:color="#334DD0E1" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
