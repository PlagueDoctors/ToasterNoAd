<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        读取已安装应用列表。
        Android 11+ 的包可见性限制下，读取全量应用需要此权限。
        用途：让用户选择需要对哪些应用做广告拦截，属于该权限的合理场景。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 拦截通知（Android 13+ 需运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务：S2/S3 的 VpnService 与保活（阶段 C 起使用） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 网络状态：用于检测其他 VPN 是否运行（让位仲裁） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 开机自启动（可选，由设置开关控制） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        请求「忽略电池优化」豁免（设置页提供入口）。
        在激进省电 ROM（努比亚等）上，系统可能直接杀前台服务或拒绝
        后台启动；官方豁免清单里「用户关闭电池优化」是确定可用的
        后台前台服务启动豁免 —— 需要用户在系统弹窗中确认一次。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".NoAdApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoAd">

        <!--
            excludeFromRecents="true"（R10）：上划后台应用列表（最近任务）中
            不显示本应用。

            - 隐藏的是**任务卡片**，任务本身照常存在于后台：
              点桌面图标仍回到原界面，服务与无障碍绑定不受影响
            - 附带收益：后台卡片不存在 → 无法从最近任务划掉/一键清理
              本应用，与 R9 保活互为补充（但 force-stop 仍不可自启，
              见 KeepAliveService 的诚实边界）
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NoAd"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            S1 无障碍拦截服务。

            权限声明：android:permission 必须为 BIND_ACCESSIBILITY_SERVICE，
            否则任何应用都能通过 bindService 调用本服务。

            android:exported="true" 是必需的 —— 它由系统（跨进程）绑定。

            tools:ignore="AccessibilityPolicy" 用于抑制 Lint 对
            无障碍服务用途的检查：本应用的核心功能就是无障碍点击，
            属于该 API 的正当用途（详见 accessibility_service_description）。
        -->
        <service
            android:name=".core.service.NoAdAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            应用进程保活前台服务（R9）。

            - foregroundServiceType="specialUse"：本应用不属于任何
              既有类型（音乐/定位/同步等）；specialUse 配合下方 subtype
              属性向系统声明用途。Android 15 起的 BOOT_COMPLETED
              前台服务启动白名单明确包含 specialUse
              （兼容框架 FGS_BOOT_COMPLETED_RESTRICTIONS 豁免类型之一）
            - exported="false"：只有本应用自己启动它
            - 常驻通知为系统强制要求，使用低优先级静默渠道
        -->
        <service
            android:name=".core.service.keepalive.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep the ad-blocking accessibility service process alive so interception survives process death" />
        </service>

        <!--
            保活链条的外部触发入口：开机 / 应用更新 / 心跳闹钟。

            - exported="true"：BOOT_COMPLETED 与 MY_PACKAGE_REPLACED 都是
              受保护系统广播（第三方无法伪造），导出无风险；
              部分厂商 ROM 对非导出接收器的系统广播投递不可靠
            - 心跳 action 走显式 Intent 投递，不进 filter，无暴露面
        -->
        <receiver
            android:name=".core.service.keepalive.KeepAliveReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            ShizukuProvider（R11 / 阶段 F1，方案 §6.3.2 的官方标准声明）。

            Shizuku 运行器通过该 provider 与本应用交换 binder：
            - authorities 必须为 ${applicationId}.shizuku
            - exported="true" + INTERACT_ACROSS_USERS_FULL（签名级）：
              只有 Shizuku 运行器（系统 shell 身份）能访问，第三方应用无法触碰
            - 单进程应用，multiprocess="false"（与 NoAdApplication 中的
              enableMultiProcessSupport(false) 对应）

            未安装 Shizuku 时该 provider 静默闲置，全部功能正常（§13.1 可选增强）。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
